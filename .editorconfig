# Editor-side half of the LF policy declared in .gitattributes. Git normalizes what is committed;
# this stops an editor writing CRLF into the working tree in the first place, so a diff never shows
# a whole file changed because someone opened it in a tool with different defaults.
#
# Coverage is uneven, which is why this file is not the whole story. The JetBrains IDEs honour it
# natively. **VS Code does not** — it needs the EditorConfig.EditorConfig extension — and **RStudio
# does not honour it reliably**, which matters most here: RStudio's own LineEndingConversion defaults
# to Native (CRLF on Windows). So the same settings are repeated in .vscode/settings.json
# (files.eol / files.encoding) and in neoipcr.Rproj (LineEndingConversion / Encoding). Those are not
# redundant; they are the coverage this file lacks.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so trailing whitespace is significant.
[*.md]
trim_trailing_whitespace = false

# gettext catalogues are machine-written: never add or trim whitespace here. LF and UTF-8 still apply,
# as everywhere — a catalogue's own header declares charset=UTF-8, and carving it out of the line-ending
# contract is what produced mixed-CRLF corruption before. Only the two whitespace properties are off.
[*.{po,pot}]
insert_final_newline = false
trim_trailing_whitespace = false

# Generated by roxygen2 on every document() run; do not let an editor reformat them independently.
[man/*.Rd]
trim_trailing_whitespace = false
